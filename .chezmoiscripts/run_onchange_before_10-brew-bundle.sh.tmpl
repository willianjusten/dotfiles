#!/bin/bash
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
# Brewfile.{{ .machine }} hash: {{ include (printf "Brewfile.%s" .machine) | sha256sum }}
set -uo pipefail
eval "$(/opt/homebrew/bin/brew shellenv)"

# Installs and upgrades only; never uninstalls anything missing from the Brewfiles.
# A failed entry (e.g. mas before App Store sign-in) only warns: exiting non-zero
# here would stop chezmoi before it writes any file.
for brewfile in "{{ .chezmoi.sourceDir }}/Brewfile" "{{ .chezmoi.sourceDir }}/Brewfile.{{ .machine }}"; do
  if ! brew bundle --file="$brewfile"; then
    echo "WARNING: some entries in $brewfile failed. Fix them, then run: brew bundle --file=$brewfile" >&2
  fi
done
