[user]
  name = Willian Justen de Vasconcellos
  email = {{ .personal_email }}
{{- if .use_1password }}
  signingkey = {{ onepasswordRead "op://Personal/GitHub SSH/public key" .op_personal_account | trim }}
[gpg]
  format = ssh
[gpg "ssh"]
  program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
  gpgsign = true
{{- end }}
[includeIf "gitdir:~/Developer/github/"]
  path = ~/.gitconfig-github
[includeIf "gitdir:~/Developer/spoke/"]
  path = ~/.gitconfig-spoke
[core]
  excludesfile = ~/.gitignore_global
  fsmonitor = true
  untrackedCache = true
[feature]
  manyFiles = true
[branch]
  autosetuprebase = always
  sort = -committerdate
[alias]
  ba = branch -a
  bd = branch -D
  bm = branch -m
  cm = commit -m
  co = checkout
  cb = checkout -b
  sw = switch
  sc = switch -c
  su = stash -u
  sa = stash apply
  sp = stash pop
  st = status -s
  ca = !git add -A && git commit -m
  sg = !git add -A && git stash
  sf = show --name-only
  lg = log --oneline --decorate --pretty=format:'%C(yellow)%h%C(red)%d %C(white)%s %C(blue)<%cn> %C(green)(%cr - %C(green)%ad)' --date=local
  pf = push -f
  pl = push --force-with-lease
  no-edit = commit --no-edit
  amend = !git commit --amend --no-edit
  clear = !git fetch origin && git reset --hard origin/$(git symbolic-ref --short HEAD)
  undo = reset --soft HEAD^
  unstage = reset HEAD --
  rollback = checkout .
  count = rev-list --count HEAD
[color]
  ui = true
[color "status"]
  added = green
  changed = yellow
  untracked = red
[color "branch"]
  current = white
  local = green
  remote = red
[color "diff"]
  meta = yellow
  old = red
  new = green
[init]
  defaultBranch = main
[fetch]
  prune = true
[push]
  default = current
[pull]
  rebase = true
[merge]
  log = true
